filters:
  and:
    - file.inFolder("Spells")
properties:
  note.Display title:
    displayName: Name
  file.name:
    displayName: file name
views:
  - type: table
    name: Spells
    order:
      - Spell Level
      - Name
      - School
      - Classes
      - Special
      - Source
      - Official
    sort:
      - property: Spell Level
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.Name: 216
  - type: table
    name: Osteomancy Spells
    filters:
      and:
        - School.contains("Osteomancy")
    order:
      - Spell Level
      - Name
      - School
      - Classes
      - Special
      - Source
    sort:
      - property: Spell Level
        direction: ASC
