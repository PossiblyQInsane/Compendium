filters:
  and:
    - file.inFolder("Spells")
properties:
  note.Display title:
    displayName: Name
  file.name:
    displayName: file name
views:
  - type: table
    name: Spells
    order:
      - Spell Level
      - Name
      - School
      - Classes
      - Special
      - Source
      - tags
    sort:
      - property: Spell Level
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.Name: 216
  - type: table
    name: Artificer Spell List
    filters:
      and:
        - Classes.contains("Artificer")
    groupBy:
      property: Spell Level
      direction: ASC
    order:
      - Spell Level
      - Name
      - School
      - Special
      - Source
    sort:
      - property: Spell Level
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.Name: 243
