filters:
  and:
    - file.inFolder("Equipment")
views:
  - type: table
    name: Weapons
    filters:
      and:
        - file.inFolder("Equipment/Weapons")
    order:
      - file.name
      - Category
      - Damage
      - Properties
      - Mastery
      - Weight
      - Cost
      - Source
      - tags
    columnSize:
      file.name: 121
  - type: table
    name: Armor
    filters:
      and:
        - file.inFolder("Equipment/Armor")
    groupBy:
      property: Category
      direction: ASC
    order:
      - file.name
      - Category
      - Armor Class (AC)
      - Weight
      - Cost
      - Source
      - tags
    columnSize: {}
  - type: table
    name: Tools
    filters:
      and:
        - file.inFolder("Equipment/Tools")
    order:
      - file.name
      - Category
      - Cost
      - Weight
      - Ability
      - Craft
      - Source
      - tags
    sort:
      - property: file.name
        direction: ASC
      - property: Category
        direction: ASC
  - type: table
    name: Adventuring Gear
    filters:
      and:
        - file.inFolder("Equipment/Adventuring Gear")
    order:
      - file.name
      - Weight
      - Cost
      - Source
      - tags
  - type: table
    name: Simple Weapons
    filters:
      and:
        - Category.contains("Simple")
    order:
      - file.name
      - Category
      - Damage
      - Properties
      - Mastery
      - Weight
      - Cost
      - Source
      - tags
  - type: table
    name: Light Armor
    filters:
      and:
        - Category == "Light Armor"
    order:
      - file.name
      - Armor Class (AC)
      - Weight
      - Cost
      - Source
      - tags
    columnSize:
      note.Cost: 113
  - type: table
    name: Medium Armor
    filters:
      and:
        - Category == "Medium Armor"
  - type: table
    name: Heavy Armor
    filters:
      and:
        - Category.contains("Heavy")
  - type: table
    name: Shields
    filters:
      and:
        - Category == "Shield"
  - type: table
    name: Artisan's Tools
    filters:
      and:
        - Category == "Artisan's Tools"
    order:
      - file.name
      - Cost
      - Weight
      - Source
      - tags
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 251
      note.Cost: 113
    indentProperties: true
  - type: table
    name: Martial Weapons
    filters:
      and:
        - Category.contains("Martial")
