filters:
  and:
    - file.inFolder("Equipment")
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Equipment
    order:
      - file.name
      - Weight
      - Cost
      - Source
      - Official
  - type: table
    name: Weapons
    filters:
      and:
        - file.tags.contains("weapon")
    groupBy:
      property: Category
      direction: ASC
    order:
      - file.name
      - Damage
      - Properties
      - Mastery
      - Weight
      - Cost
      - Source
      - Official
    sort:
      - property: Category
        direction: ASC
    columnSize:
      file.name: 121
  - type: table
    name: Armor
    filters:
      and:
        - file.inFolder("Equipment/Armor")
    groupBy:
      property: Category
      direction: ASC
    order:
      - file.name
      - Armor Class (AC)
      - Weight
      - Cost
      - Source
      - Official
    columnSize:
      note.Cost: 113
  - type: table
    name: Tools
    filters:
      and:
        - file.tags.contains("tools")
    order:
      - file.name
      - Cost
      - Weight
      - Ability
      - Craft
      - Source
      - Official
    sort:
      - property: file.name
        direction: ASC
      - property: Category
        direction: ASC
  - type: table
    name: Adventuring Gear
    filters:
      and:
        - file.inFolder("Equipment/Adventuring Gear")
    order:
      - file.name
      - Weight
      - Cost
      - Source
      - Official
    sort:
      - property: tags
        direction: ASC
  - type: table
    name: Simple Weapons
    filters:
      and:
        - file.tags.contains("simple_weapon")
    order:
      - file.name
      - Damage
      - Properties
      - Mastery
      - Weight
      - Cost
      - Source
      - Official
    sort:
      - property: Category
        direction: ASC
  - type: table
    name: Martial Weapons
    filters:
      and:
        - file.tags.contains("martial_weapon")
  - type: table
    name: Martial Ranged Weapons
    filters:
      and:
        - file.tags.containsAll("martial_weapon", "ranged_weapon")
  - type: table
    name: Light Armor
    filters:
      and:
        - file.tags.contains("light_armor")
    order:
      - file.name
      - Armor Class (AC)
      - Weight
      - Cost
      - Source
      - Official
    columnSize:
      note.Cost: 113
  - type: table
    name: Medium Armor
    filters:
      and:
        - file.tags.contains("medium_armor")
  - type: table
    name: Heavy Armor
    filters:
      and:
        - file.tags.contains("heavy_armor")
  - type: table
    name: Shields
    filters:
      and:
        - Category == "Shield"
  - type: table
    name: Artisan's Tools
    filters:
      and:
        - Category == "Artisan's Tools"
    order:
      - file.name
      - Cost
      - Weight
      - Source
      - Official
    sort:
      - property: tags
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 251
      note.Cost: 113
    indentProperties: true
