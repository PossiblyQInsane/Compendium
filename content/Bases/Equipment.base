filters:
  and:
    - file.inFolder("Equipment")
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Equipment
    order:
      - file.name
      - Weight
      - Cost
      - Source
      - Official
    sort:
      - property: file.name
        direction: ASC
      - property: Official
        direction: DESC
  - type: table
    name: Weapons
    filters:
      and:
        - file.inFolder("Equipment/Weapons")
    groupBy:
      property: Category
      direction: ASC
    order:
      - file.name
      - Damage
      - Properties
      - Mastery
      - Weight
      - Cost
      - Source
      - Official
    sort:
      - property: Category
        direction: ASC
    columnSize:
      file.name: 121
  - type: table
    name: Armor
    filters:
      and:
        - file.inFolder("Equipment/Armor")
    groupBy:
      property: Category
      direction: ASC
    order:
      - file.name
      - Armor Class (AC)
      - Weight
      - Cost
      - Source
      - Official
    columnSize:
      note.Cost: 113
  - type: table
    name: Tools
    filters:
      and:
        - file.inFolder("Equipment/Tools")
    order:
      - file.name
      - Category
      - Ability
      - Weight
      - Cost
      - Source
      - Official
    sort:
      - property: file.name
        direction: ASC
      - property: Category
        direction: ASC
  - type: table
    name: Adventuring Gear
    filters:
      and:
        - file.inFolder("Equipment/Adventuring Gear")
    order:
      - file.name
      - Weight
      - Cost
      - Source
      - Official
    sort:
      - property: tags
        direction: ASC
