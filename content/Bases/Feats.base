filters:
  and:
    - file.inFolder("Feats")
views:
  - type: table
    name: Feats
    order:
      - file.name
      - Category
      - Prerequisite
      - Ability Score
      - Source
  - type: table
    name: General Feats
    filters:
      and:
        - Category == "General Feat"
    order:
      - file.name
      - Prerequisite
      - Ability Score
      - Source
  - type: table
    name: Epic Boon Feats
    filters:
      and:
        - Category == "Epic Boon Feat"
    order:
      - file.name
      - Prerequisite
      - Ability Score
      - Source
  - type: table
    name: Fighting Style Feats
    filters:
      and:
        - Category.contains("Fighting Style Feat")
    order:
      - file.name
      - Prerequisite
      - Source
