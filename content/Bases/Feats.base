filters:
  and:
    - file.inFolder("Feats")
views:
  - type: table
    name: Feats
    order:
      - file.name
      - Feat Category
      - Prerequisite
      - Ability Score
      - Source
  - type: table
    name: General Feats
    filters:
      and:
        - note["Feat Category"] == "General Feat"
    order:
      - file.name
      - Prerequisite
      - Ability Score
      - Source
  - type: table
    name: Epic Boon Feats
    filters:
      and:
        - note["Feat Category"] == "Epic Boon Feat"
    order:
      - file.name
      - Prerequisite
      - Ability Score
      - Source
  - type: table
    name: Fighting Style Feats
    filters:
      and:
        - note["Feat Category"].contains("Fighting Style Feat")
    order:
      - file.name
      - Prerequisite
      - Source
  - type: table
    name: Origin Feats
    filters:
      and:
        - note["Feat Category"] == "Origin Feat"
    order:
      - file.name
      - Prerequisite
      - Source
  - type: table
    name: Kindred Feats
    filters:
      and:
        - note["Feat Category"] == "Kindred Feat"
    order:
      - file.name
      - Prerequisite
      - Ability Score
      - Source
